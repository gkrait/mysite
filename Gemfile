# Specifies the source for downloading gems. HTTPS is preferred for security.
source 'https://rubygems.org'

# Specify Jekyll plugins and other dependencies for the site.

# JSON parsing library, often a core dependency for Ruby projects.
gem 'json', '>= 1.8'

# Canvas-based library for drawing in a sketchy, hand-drawn-like style.
gem 'rough'

# Standard Jekyll plugin for blog post pagination.
gem 'jekyll-paginate'

# Jekyll plugin for generating geometric background patterns.
gem 'jekyll-geo-pattern'

# Markdown converter used by Jekyll.
gem 'kramdown'

# Jekyll plugin for accessing GitHub repository metadata (e.g., for project pages).
gem 'jekyll-github-metadata'

# WEBrick is a simple HTTP server toolkit for Ruby.
# Used by `jekyll serve` in older Ruby/Jekyll versions, or if specified.
# Jekyll 4+ defaults to Puma, but WEBrick might be needed for specific setups or compatibility.
gem "webrick", "~> 1.7"
